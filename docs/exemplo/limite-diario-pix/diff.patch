+    private Payment pay(Long accountId, long amount) {
+        return service.pay(new PaymentRequest(accountId, "key", BigDecimal.valueOf(amount)));
+    }
+
+    private void account(Long accountId, String tier) {
+        Long customerId = accountId + 100;
+        when(accounts.balance(accountId)).thenReturn(new AccountBalance(accountId, customerId, BigDecimal.valueOf(100_000), "ACTIVE"));
+        when(riskProfiles.riskProfile(customerId)).thenReturn(Optional.ofNullable(tier).map(t -> new RiskProfile(customerId, 50, t)));
+    }
