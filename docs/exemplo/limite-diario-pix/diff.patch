+import java.math.BigDecimal;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.mock.env.MockEnvironment;
+
+class PaymentServiceDailyLimitTest {
+
+    private static final ZoneId SAO_PAULO = ZoneId.of("America/Sao_Paulo");
+
+    private final AccountGraphClient accounts = mock(AccountGraphClient.class);
+    private final RiskProfileClient riskProfiles = mock(RiskProfileClient.class);
+    private final PixGatewayClient pix = mock(PixGatewayClient.class);
+    private final FraudApi fraud = mock(FraudApi.class);
+    private final PaymentEventPublisher publisher = mock(PaymentEventPublisher.class);
+    private final MutableClock clock = new MutableClock(at(2026, 9, 25, 12, 0), SAO_PAULO);
+    private PaymentService service;
+
+    @BeforeEach
+    void setUp() {
+        MockEnvironment environment = new MockEnvironment()
+                .withProperty("app.limits.LOW", "50000")
+                .withProperty("app.limits.MEDIUM", "15000")
+                .withProperty("app.limits.HIGH", "3000")
+                .withProperty("app.daily-limits.LOW", "20000")
+                .withProperty("app.daily-limits.MEDIUM", "8000")
+                .withProperty("app.daily-limits.HIGH", "2000");
+        service = new PaymentService(accounts, riskProfiles, pix, fraud, publisher, environment, clock);
+        when(pix.transfer(anyString(), any())).thenReturn("E2E");
+        allowFraud();
+    }
+
+    @Test
+    void completesFirstPaymentOfTheDayWithinLimit() {
+        account(1L, "HIGH");
+
+        Payment payment = pay(1L, 1500);
+
+        assertThat(payment.status()).isEqualTo(PaymentStatus.COMPLETED);
+        verify(publisher).paymentCompleted(payment);
+    }
+
+    @Test
+    void completesPaymentThatReachesExactlyTheDailyLimit() {
+        account(1L, "HIGH");
+        pay(1L, 1500);
+
+        assertThat(pay(1L, 500).status()).isEqualTo(PaymentStatus.COMPLETED);
+    }
+
+    @Test
+    void rejectsPaymentAboveTheDailyLimitWithoutCallingFraudOrPix() {
+        account(1L, "HIGH");
+        pay(1L, 1500);
+
+        Payment payment = pay(1L, 501);
+
+        assertThat(payment.status()).isEqualTo(PaymentStatus.REJECTED);
+        assertThat(payment.reason()).isEqualTo("above daily pix limit of 2000");
+        verify(pix, never()).transfer("key", BigDecimal.valueOf(501));
+        verify(publisher, never()).paymentCompleted(payment);
+        verify(fraud, times(1)).evaluate(any());
+    }
+
+    @Test
+    void usesDailyLimitOfTheRiskTier() {
+        account(1L, "MEDIUM");
+        account(2L, "LOW");
+        pay(1L, 7000);
+        pay(2L, 7000);
+
+        Payment medium = pay(1L, 1001);
+        Payment low = pay(2L, 1001);
+
+        assertThat(medium.status()).isEqualTo(PaymentStatus.REJECTED);
+        assertThat(medium.reason()).isEqualTo("above daily pix limit of 8000");
+        assertThat(low.status()).isEqualTo(PaymentStatus.COMPLETED);
+    }
+
+    @Test
+    void usesDefaultDailyLimitWhenThereIsNoRiskProfile() {
+        account(1L, null);
+        pay(1L, 800);
+
+        Payment payment = pay(1L, 201);
+
+        assertThat(payment.status()).isEqualTo(PaymentStatus.REJECTED);
