+    }
+
+    @Test
+    void usesDefaultDailyLimitWhenTierIsNotMapped() {
+        account(1L, "UNKNOWN");
+        pay(1L, 800);
+
+        assertThat(pay(1L, 201).reason()).isEqualTo("above daily pix limit of 1000");
+    }
