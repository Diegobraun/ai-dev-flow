+    @Test
+    void allowsOnlyOneOfTwoConcurrentPaymentsThatTogetherExceedTheLimit() throws Exception {
+        account(1L, "HIGH");
+        pay(1L, 1500);
+        when(pix.transfer(anyString(), any())).thenAnswer(invocation -> {
+            Thread.sleep(200);
+            return "E2E";
+        });
+        CountDownLatch start = new CountDownLatch(1);
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+        try {
+            List<Future<Payment>> futures = List.of(
+                    executor.submit(() -> {
+                        start.await();
+                        return pay(1L, 500);
+                    }),
+                    executor.submit(() -> {
+                        start.await();
+                        return pay(1L, 500);
+                    }));
+            start.countDown();
+
+            List<Payment> results = List.of(futures.get(0).get(), futures.get(1).get());
+
+            assertThat(results).filteredOn(p -> p.status() == PaymentStatus.COMPLETED).hasSize(1);
+            assertThat(results).filteredOn(p -> p.status() == PaymentStatus.REJECTED)
+                    .singleElement()
+                    .extracting(Payment::reason)
+                    .isEqualTo("above daily pix limit of 2000");
+        } finally {
+            executor.shutdownNow();
+        }
+    }
