+package com.example.payment.payment;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.clearInvocations;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.example.payment.client.AccountBalance;
+import com.example.payment.client.AccountGraphClient;
+import com.example.payment.client.FraudApi;
+import com.example.payment.client.FraudEvaluation;
+import com.example.payment.client.PixGatewayClient;
+import com.example.payment.client.RiskProfile;
+import com.example.payment.client.RiskProfileClient;
+import com.example.payment.messaging.PaymentEventPublisher;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.math.BigDecimal;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.atomic.AtomicLong;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Primary;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+
+/**
+ * Critérios de aceite de limite-diario-pix exercitados via HTTP (POST /payments) com o contexto Spring completo.
+ * Limites vêm do application.yml real. Só as integrações externas são mockadas.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class PaymentDailyLimitIntegrationTest {
+
+    private static final ZoneId SAO_PAULO = ZoneId.of("America/Sao_Paulo");
+    private static final AtomicLong ACCOUNT_IDS = new AtomicLong(10_000);
+
+    @TestConfiguration
+    static class TestClockConfig {
+        @Bean
+        @Primary
+        MutableClock testClock() {
+            return new MutableClock(at(2026, 9, 25, 12, 0), SAO_PAULO);
+        }
+    }
+
+    @Autowired MockMvc mvc;
+    @Autowired ObjectMapper json;
+    @Autowired MutableClock clock;
+
+    @MockitoBean AccountGraphClient accounts;
+    @MockitoBean RiskProfileClient riskProfiles;
+    @MockitoBean FraudApi fraud;
+    @MockitoBean PixGatewayClient pix;
+    @MockitoBean PaymentEventPublisher publisher;
+
+    @BeforeEach
+    void setUp() {
+        clock.set(at(2026, 9, 25, 12, 0));
+        when(pix.transfer(anyString(), any())).thenReturn("E2E-OK");
+        allowFraud();
+    }
+
+    // Critério 1
+    @Test
+    void criterio1_contaHighSemPagamentosNoDiaPaga1500_ficaCompletedEPublicaEvento() throws Exception {
+        long acc = account("HIGH");
+
+        pay(acc, 1500)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("COMPLETED"))
+                .andExpect(jsonPath("$.endToEndId").value("E2E-OK"));
+
+        verify(publisher).paymentCompleted(any(Payment.class));
+    }
+
+    // Critério 2
+    @Test
+    void criterio2_contaHighCom1500HojePaga500_ficaCompletedNoLimiteExato() throws Exception {
+        long acc = account("HIGH");
+        expectStatus(acc, 1500, "COMPLETED");
+
+        pay(acc, 500)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("COMPLETED"));
+    }
+
+    // Critério 3
+    @Test
+    void criterio3_contaHighCom1500HojePaga501_rejeitadaSemFraudeSemPixSemEvento() throws Exception {
+        long acc = account("HIGH");
+        expectStatus(acc, 1500, "COMPLETED");
+        clearInvocations(fraud, pix, publisher);
+
+        pay(acc, 501)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("REJECTED"))
+                .andExpect(jsonPath("$.reason").value("above daily pix limit of 2000"));
+
+        verify(fraud, never()).evaluate(any());
+        verify(pix, never()).transfer(anyString(), any());
+        verify(publisher, never()).paymentCompleted(any());
+    }
+
+    // Critério 4
+    @Test
+    void criterio4_limiteDiarioDependeDaFaixa_mediumRejeitaLowAceita() throws Exception {
+        long medium = account("MEDIUM");
+        long low = account("LOW");
+        expectStatus(medium, 7000, "COMPLETED");
+        expectStatus(low, 7000, "COMPLETED");
+
+        pay(medium, 1001)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("REJECTED"))
+                .andExpect(jsonPath("$.reason").value("above daily pix limit of 8000"));
+        pay(low, 1001)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("COMPLETED"));
+    }
+
+    // Critério 5
+    @Test
+    void criterio5_clienteSemPerfilDeRiscoCom800HojePaga201_rejeitadoComLimitePadrao1000() throws Exception {
+        long acc = account(null);
+        expectStatus(acc, 800, "COMPLETED");
+
+        pay(acc, 201)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("REJECTED"))
+                .andExpect(jsonPath("$.reason").value("above daily pix limit of 1000"));
+    }
+
+    // Critério 6
+    @Test
+    void criterio6_pagamentosRejeitadosNaoEntramNaSoma() throws Exception {
+        long acc = account("HIGH");
+        when(fraud.evaluate(any())).thenReturn(new FraudEvaluation("DENY", 90, List.of()));
+        pay(acc, 1900)
+                .andExpect(jsonPath("$.status").value("REJECTED"))
+                .andExpect(jsonPath("$.reason").value("denied by fraud prevention"));
+        allowFraud();
+
+        pay(acc, 1500)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("COMPLETED"));
+    }
+
+    // Critério 7 (parte 1): virada do dia em America/Sao_Paulo
+    @Test
+    void criterio7_pagamentoDas2359DeOntemNaoContaParaHoje() throws Exception {
+        long acc = account("HIGH");
+        clock.set(at(2026, 9, 24, 23, 59));
+        expectStatus(acc, 2000, "COMPLETED");
+
+        clock.set(at(2026, 9, 25, 0, 1));
+        pay(acc, 1500)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("COMPLETED"));
+    }
+
+    // Critério 7 (parte 2): 22:00 de ontem em SP = 01:00 UTC de hoje, conta como ontem
+    @Test
+    void criterio7_pagamentoDas22hDeOntemEmSaoPauloContaComoOntemMesmoSendoHojeEmUtc() throws Exception {
+        long acc = account("HIGH");
+        Instant ontem22hSp = at(2026, 9, 24, 22, 0);
+        assertThat(ontem22hSp).isEqualTo(Instant.parse("2026-09-25T01:00:00Z"));
+        clock.set(ontem22hSp);
+        expectStatus(acc, 2000, "COMPLETED");
+
+        // ainda "ontem" em SP: o limite do dia já está cheio
+        clock.set(at(2026, 9, 24, 23, 0));
+        pay(acc, 1)
+                .andExpect(jsonPath("$.status").value("REJECTED"))
+                .andExpect(jsonPath("$.reason").value("above daily pix limit of 2000"));
+
+        // "hoje" em SP: acumulado zerado
+        clock.set(at(2026, 9, 25, 10, 0));
+        pay(acc, 1500)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("COMPLETED"));
+    }
+
+    // Critério 8
+    @Test
+    void criterio8_limiteEPorConta() throws Exception {
+        long a = account("HIGH");
+        long b = account("HIGH");
+        expectStatus(a, 2000, "COMPLETED");
+
+        pay(b, 1500)
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("COMPLETED"));
+    }
+
+    // Critério 9
+    @Test
+    void criterio9_doisPagamentosParalelosQueJuntosPassamDoLimite_exatamenteUmCompleted() throws Exception {
+        long acc = account("HIGH");
+        expectStatus(acc, 1500, "COMPLETED");
+        when(pix.transfer(anyString(), any())).thenAnswer(invocation -> {
+            Thread.sleep(300);
+            return "E2E-OK";
+        });
+
+        CountDownLatch start = new CountDownLatch(1);
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+        try {
+            List<Future<JsonNode>> futures = new ArrayList<>();
+            for (int i = 0; i < 2; i++) {
+                futures.add(executor.submit(() -> {
+                    start.await();
+                    String body = pay(acc, 500).andExpect(status().isCreated()).andReturn().getResponse().getContentAsString();
+                    return json.readTree(body);
+                }));
+            }
+            start.countDown();
+
+            List<JsonNode> results = List.of(futures.get(0).get(), futures.get(1).get());
+
+            assertThat(results).filteredOn(r -> "COMPLETED".equals(r.get("status").asText())).hasSize(1);
+            assertThat(results).filteredOn(r -> "REJECTED".equals(r.get("status").asText()))
+                    .singleElement()
+                    .extracting(r -> r.get("reason").asText())
+                    .isEqualTo("above daily pix limit of 2000");
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+
+    private ResultActions pay(long accountId, long amount) throws Exception {
+        String body = """
+                {"accountId": %d, "pixKey": "chave@pix", "amount": %d}
+                """.formatted(accountId, amount);
+        return mvc.perform(post("/payments").contentType(MediaType.APPLICATION_JSON).content(body));
+    }
+
+    private void expectStatus(long accountId, long amount, String expected) throws Exception {
+        pay(accountId, amount).andExpect(status().isCreated()).andExpect(jsonPath("$.status").value(expected));
+    }
+
+    private long account(String tier) {
+        long accountId = ACCOUNT_IDS.incrementAndGet();
+        long customerId = accountId + 500_000;
+        when(accounts.balance(accountId)).thenReturn(new AccountBalance(accountId, customerId, BigDecimal.valueOf(100_000), "ACTIVE"));
+        when(riskProfiles.riskProfile(customerId))
+                .thenReturn(Optional.ofNullable(tier).map(t -> new RiskProfile(customerId, 50, t)));
+        return accountId;
+    }
+
+    private void allowFraud() {
+        when(fraud.evaluate(any())).thenReturn(new FraudEvaluation("ALLOW", 0, List.of()));
+    }
+
+    private static Instant at(int year, int month, int day, int hour, int minute) {
+        return LocalDateTime.of(year, month, day, hour, minute).atZone(SAO_PAULO).toInstant();
+    }
+
+    static final class MutableClock extends Clock {
+
+        private volatile Instant instant;
+        private final ZoneId zone;
+
+        MutableClock(Instant instant, ZoneId zone) {
+            this.instant = instant;
+            this.zone = zone;
+        }
+
+        void set(Instant instant) {
+            this.instant = instant;
+        }
+
+        @Override
+        public ZoneId getZone() {
+            return zone;
+        }
+
+        @Override
+        public Clock withZone(ZoneId zone) {
+            return new MutableClock(instant, zone);
+        }
+
+        @Override
+        public Instant instant() {
+            return instant;
+        }
+    }
+}
