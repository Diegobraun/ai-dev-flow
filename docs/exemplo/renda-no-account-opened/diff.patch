diff --git a/src/test/java/com/example/account/account/AccountOpenedIncomeIntegrationTest.java b/src/test/java/com/example/account/account/AccountOpenedIncomeIntegrationTest.java
new file mode 100644
index 0000000..e5f5a33
--- /dev/null
+++ b/src/test/java/com/example/account/account/AccountOpenedIncomeIntegrationTest.java
@@ -0,0 +1,212 @@
+package com.example.account.account;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.example.account.messaging.Topics;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import org.apache.kafka.clients.producer.MockProducer;
+import org.apache.kafka.clients.producer.ProducerRecord;
+import org.apache.kafka.common.serialization.Serializer;
+import org.apache.kafka.common.serialization.StringSerializer;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.BeanUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.autoconfigure.kafka.KafkaProperties;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.context.annotation.Bean;
+import org.springframework.http.MediaType;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.mock.MockProducerFactory;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * Testes de aceite da tarefa renda-no-account-opened.
+ *
+ * <p>A aplicação sobe inteira: controllers, serviço, repositórios e o publisher real. Só o transporte Kafka é
+ * trocado. O {@link KafkaTemplate} usa um {@link MockProducer} com o value serializer configurado em
+ * {@code application.yml} (JsonSerializer, sem type headers). O JSON conferido é o que iria para o broker.
+ */
+@SpringBootTest(properties = "spring.kafka.listener.auto-startup=false")
+@AutoConfigureMockMvc
+class AccountOpenedIncomeIntegrationTest {
+
+    @TestConfiguration
+    static class KafkaMockConfig {
+
+        @Bean
+        @SuppressWarnings("unchecked")
+        Serializer<Object> producerValueSerializer(KafkaProperties properties) {
+            Map<String, Object> config = properties.buildProducerProperties(null);
+            Serializer<Object> serializer =
+                    (Serializer<Object>) BeanUtils.instantiateClass(properties.getProducer().getValueSerializer());
+            serializer.configure(config, false);
+            return serializer;
+        }
+
+        @Bean
+        MockProducer<String, Object> mockProducer(Serializer<Object> producerValueSerializer) {
+            // O KafkaTemplate fecha o producer depois de cada envio. Aqui ele é compartilhado entre os testes.
+            return new MockProducer<>(true, null, new StringSerializer(), producerValueSerializer) {
+                @Override
+                public void close() {
+                }
+
+                @Override
+                public void close(java.time.Duration timeout) {
+                }
+            };
+        }
+
+        @Bean
+        KafkaTemplate<String, Object> kafkaTemplate(MockProducer<String, Object> mockProducer) {
+            return new KafkaTemplate<>(new MockProducerFactory<>(() -> mockProducer));
+        }
+    }
+
+    /** Mesmo formato do {@code com.example.loan.messaging.AccountOpenedEvent} do loan-service. */
+    record LoanServiceAccountOpenedEvent(Long accountId, Long customerId, BigDecimal monthlyIncome) {
+    }
+
+    @Autowired
+    MockMvc mvc;
+
+    @Autowired
+    MockProducer<String, Object> producer;
+
+    @Autowired
+    Serializer<Object> producerValueSerializer;
+
+    @Autowired
+    ObjectMapper objectMapper;
+
+    @BeforeEach
+    void clearSentRecords() {
+        producer.clear();
+    }
+
+    @Test
+    void criterio1_publicaRendaNoTopicoAccountOpenedIncomeComChaveAccountId() throws Exception {
+        long customerId = createCustomer("8500.00");
+        long accountId = openAccount(customerId);
+
+        List<ProducerRecord<String, Object>> income = sentTo(Topics.ACCOUNT_OPENED_INCOME);
+        assertThat(income).hasSize(1);
+        assertThat(income.get(0).key()).isEqualTo(String.valueOf(accountId));
+
+        JsonNode json = json(income.get(0));
+        assertThat(json.get("accountId").asLong()).isEqualTo(accountId);
+        assertThat(json.get("customerId").asLong()).isEqualTo(customerId);
+        assertThat(json.hasNonNull("openedAt")).isTrue();
+        assertThat(json.get("monthlyIncome").isNumber()).isTrue();
+        BigDecimal monthlyIncome = json.get("monthlyIncome").decimalValue();
+        assertThat(monthlyIncome).isEqualByComparingTo("8500.00");
+        assertThat(monthlyIncome.scale()).isEqualTo(2);
+        assertThat(rawJson(income.get(0))).contains("\"monthlyIncome\":8500.00");
+    }
+
+    @Test
+    void criterio2_accountOpenedMantemSoAccountIdCustomerIdOpenedAtSemRenda() throws Exception {
+        long customerId = createCustomer("8500.00");
+        long accountId = openAccount(customerId);
+
+        List<ProducerRecord<String, Object>> opened = sentTo(Topics.ACCOUNT_OPENED);
+        assertThat(opened).hasSize(1);
+        assertThat(opened.get(0).key()).isEqualTo(String.valueOf(accountId));
+
+        JsonNode json = json(opened.get(0));
+        assertThat(json.properties()).extracting(Map.Entry::getKey)
+                .containsExactlyInAnyOrder("accountId", "customerId", "openedAt");
+        assertThat(json.get("accountId").asLong()).isEqualTo(accountId);
+        assertThat(json.get("customerId").asLong()).isEqualTo(customerId);
+        assertThat(rawJson(opened.get(0))).doesNotContain("monthlyIncome").doesNotContain("8500");
+        assertThat(opened.get(0).headers().toArray()).as("sem type headers").isEmpty();
+    }
+
+    @Test
+    void criterio3_rendaZeroEPublicadaComoZeroENaoNull() throws Exception {
+        long customerId = createCustomer("0");
+        openAccount(customerId);
+
+        List<ProducerRecord<String, Object>> income = sentTo(Topics.ACCOUNT_OPENED_INCOME);
+        assertThat(income).hasSize(1);
+        JsonNode monthlyIncome = json(income.get(0)).get("monthlyIncome");
+        assertThat(monthlyIncome).isNotNull();
+        assertThat(monthlyIncome.isNull()).isFalse();
+        assertThat(monthlyIncome.decimalValue()).isEqualByComparingTo(BigDecimal.ZERO);
+    }
+
+    @Test
+    void criterio4_clienteInexistenteRetorna422ENaoPublicaEmNenhumTopico() throws Exception {
+        mvc.perform(post("/accounts")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"customerId\": 999999}"))
+                .andExpect(status().isUnprocessableEntity())
+                .andExpect(result -> assertThat(result.getResolvedException())
+                        .hasMessageContaining("customer not found"));
+
+        assertThat(producer.history()).isEmpty();
+    }
+
+    @Test
+    void criterio5_jsonDeAccountOpenedIncomeEhLidoPeloRecordDoLoanService() throws Exception {
+        long customerId = createCustomer("8500.00");
+        long accountId = openAccount(customerId);
+
+        ProducerRecord<String, Object> record = sentTo(Topics.ACCOUNT_OPENED_INCOME).get(0);
+        LoanServiceAccountOpenedEvent read = objectMapper.readValue(bytes(record), LoanServiceAccountOpenedEvent.class);
+
+        assertThat(read.accountId()).isEqualTo(accountId);
+        assertThat(read.customerId()).isEqualTo(customerId);
+        assertThat(read.monthlyIncome()).isNotNull().isEqualByComparingTo("8500.00");
+    }
+
+    private long createCustomer(String monthlyIncome) throws Exception {
+        String body = mvc.perform(post("/customers")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"name\":\"Maria\",\"document\":\"12345678900\",\"monthlyIncome\":" + monthlyIncome + "}"))
+                .andExpect(status().isCreated())
+                .andReturn().getResponse().getContentAsString();
+        return objectMapper.readTree(body).get("id").asLong();
+    }
+
+    private long openAccount(long customerId) throws Exception {
+        String body = mvc.perform(post("/accounts")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"customerId\":" + customerId + "}"))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.customerId").value(customerId))
+                .andReturn().getResponse().getContentAsString();
+        return objectMapper.readTree(body).get("id").asLong();
+    }
+
+    private List<ProducerRecord<String, Object>> sentTo(String topic) {
+        return producer.history().stream().filter(r -> topic.equals(r.topic())).toList();
+    }
+
+    private byte[] bytes(ProducerRecord<String, Object> record) {
+        return producerValueSerializer.serialize(record.topic(), record.headers(), record.value());
+    }
+
+    private String rawJson(ProducerRecord<String, Object> record) {
+        return new String(bytes(record), StandardCharsets.UTF_8);
+    }
+
+    private JsonNode json(ProducerRecord<String, Object> record) throws Exception {
+        // Lê números decimais como BigDecimal, sem remover zeros à direita, para conferir valor e escala.
+        return objectMapper.reader()
+                .with(com.fasterxml.jackson.databind.DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS)
+                .without(com.fasterxml.jackson.databind.cfg.JsonNodeFeature.STRIP_TRAILING_BIGDECIMAL_ZEROES)
+                .readTree(bytes(record));
+    }
+}
