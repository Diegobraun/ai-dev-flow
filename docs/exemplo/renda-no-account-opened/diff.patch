@@ -0,0 +1,113 @@
+package com.example.account.messaging;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+
+import com.example.account.account.Account;
+import com.example.account.account.AccountStatus;
+import com.example.account.customer.Customer;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.support.JacksonUtils;
+import org.springframework.kafka.support.serializer.JsonSerializer;
+
+class AccountEventPublisherTest {
+
+    private static final Instant OPENED_AT = Instant.parse("2026-09-25T12:00:00Z");
+
+    @SuppressWarnings("unchecked")
+    private final KafkaTemplate<String, Object> kafkaTemplate = mock(KafkaTemplate.class);
+    private final AccountEventPublisher publisher = new AccountEventPublisher(kafkaTemplate);
+
+    @Test
+    void publishesIncomeOnlyOnDedicatedTopicWithAccountIdKey() {
+        publisher.accountOpened(account(), customer(new BigDecimal("8500.00")));
+
+        ArgumentCaptor<String> topics = ArgumentCaptor.forClass(String.class);
+        ArgumentCaptor<String> keys = ArgumentCaptor.forClass(String.class);
+        ArgumentCaptor<Object> payloads = ArgumentCaptor.forClass(Object.class);
+        verify(kafkaTemplate, times(2)).send(topics.capture(), keys.capture(), payloads.capture());
+
+        assertThat(topics.getAllValues()).containsExactly(Topics.ACCOUNT_OPENED, Topics.ACCOUNT_OPENED_INCOME);
+        assertThat(keys.getAllValues()).containsOnly("1001");
+
+        List<Object> sent = payloads.getAllValues();
+        assertThat(sent.get(0)).isEqualTo(new AccountOpenedEvent(1001L, 7L, OPENED_AT));
+
+        AccountOpenedIncomeEvent income = (AccountOpenedIncomeEvent) sent.get(1);
+        assertThat(income.accountId()).isEqualTo(1001L);
+        assertThat(income.customerId()).isEqualTo(7L);
+        assertThat(income.openedAt()).isEqualTo(OPENED_AT);
+        assertThat(income.monthlyIncome()).isEqualByComparingTo("8500.00");
+        assertThat(income.monthlyIncome().scale()).isEqualTo(2);
+    }
+
+    @Test
+    void accountOpenedJsonKeepsOnlyOriginalFields() throws Exception {
+        publisher.accountOpened(account(), customer(new BigDecimal("8500.00")));
+
+        ArgumentCaptor<Object> payload = ArgumentCaptor.forClass(Object.class);
+        verify(kafkaTemplate).send(eq(Topics.ACCOUNT_OPENED), anyString(), payload.capture());
+
+        JsonNode json = new ObjectMapper().readTree(serialize(Topics.ACCOUNT_OPENED, payload.getValue()));
+        assertThat(json.properties()).extracting(java.util.Map.Entry::getKey)
+                .containsExactlyInAnyOrder("accountId", "customerId", "openedAt");
+    }
+
+    @Test
+    void zeroIncomeIsPublishedAsZeroNotNull() throws Exception {
+        publisher.accountOpened(account(), customer(BigDecimal.ZERO));
+
+        ArgumentCaptor<Object> payload = ArgumentCaptor.forClass(Object.class);
+        verify(kafkaTemplate).send(eq(Topics.ACCOUNT_OPENED_INCOME), anyString(), payload.capture());
+
+        AccountOpenedIncomeEvent income = (AccountOpenedIncomeEvent) payload.getValue();
+        assertThat(income.monthlyIncome()).isNotNull().isEqualByComparingTo(BigDecimal.ZERO);
+
+        JsonNode json = new ObjectMapper().readTree(serialize(Topics.ACCOUNT_OPENED_INCOME, income));
+        assertThat(json.get("monthlyIncome").isNull()).isFalse();
+        assertThat(json.get("monthlyIncome").decimalValue()).isEqualByComparingTo(BigDecimal.ZERO);
+    }
+
+    @Test
+    void incomeEventIsReadableByLoanServiceShapedRecord() throws Exception {
+        AccountOpenedIncomeEvent event = new AccountOpenedIncomeEvent(1001L, 7L, OPENED_AT, new BigDecimal("8500.00"));
+
+        byte[] json = serialize(Topics.ACCOUNT_OPENED_INCOME, event);
+        LoanAccountOpenedEvent read = JacksonUtils.enhancedObjectMapper().readValue(json, LoanAccountOpenedEvent.class);
+
+        assertThat(read.accountId()).isEqualTo(1001L);
+        assertThat(read.customerId()).isEqualTo(7L);
+        assertThat(read.monthlyIncome()).isEqualByComparingTo("8500.00");
+        assertThat(read.monthlyIncome().scale()).isEqualTo(2);
+    }
+
+    private static byte[] serialize(String topic, Object payload) {
+        try (JsonSerializer<Object> serializer = new JsonSerializer<>()) {
+            serializer.setAddTypeInfo(false);
+            return serializer.serialize(topic, payload);
+        }
+    }
+
+    private static Account account() {
+        return new Account(1001L, 7L, BigDecimal.ZERO, AccountStatus.PENDING_KYC, OPENED_AT);
+    }
+
+    private static Customer customer(BigDecimal monthlyIncome) {
+        return new Customer(7L, "Maria", "12345678900", monthlyIncome, Instant.parse("2026-01-01T00:00:00Z"));
+    }
+
+    /** Mesmo formato do {@code com.example.loan.messaging.AccountOpenedEvent} do loan-service. */
+    record LoanAccountOpenedEvent(Long accountId, Long customerId, BigDecimal monthlyIncome) {
+    }
+}
