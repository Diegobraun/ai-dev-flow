+package com.example.account.account;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoInteractions;
+
+import com.example.account.customer.Customer;
+import com.example.account.customer.CustomerRepository;
+import com.example.account.loan.LoanClient;
+import com.example.account.messaging.AccountEventPublisher;
+import java.math.BigDecimal;
+import java.time.Instant;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+
+class AccountServiceTest {
+
+    private final AccountRepository accounts = new AccountRepository();
+    private final CustomerRepository customers = new CustomerRepository();
+    private final AccountEventPublisher publisher = mock(AccountEventPublisher.class);
+    private final AccountService service = new AccountService(accounts, customers, publisher, mock(LoanClient.class));
+
+    @Test
+    void openPassesLoadedCustomerToPublisher() {
+        Customer customer = customers.save(new Customer(customers.nextId(), "Maria", "12345678900",
+                new BigDecimal("8500.00"), Instant.now()));
+
+        Account account = service.open(customer.id());
+
+        assertThat(account.customerId()).isEqualTo(customer.id());
+        verify(publisher).accountOpened(account, customer);
+    }
+
+    @Test
+    void openWithUnknownCustomerFailsAndPublishesNothing() {
+        assertThatThrownBy(() -> service.open(999L))
+                .isInstanceOf(ResponseStatusException.class)
+                .satisfies(e -> assertThat(((ResponseStatusException) e).getStatusCode())
+                        .isEqualTo(HttpStatus.UNPROCESSABLE_ENTITY));
+
+        verifyNoInteractions(publisher);
+    }
+}
